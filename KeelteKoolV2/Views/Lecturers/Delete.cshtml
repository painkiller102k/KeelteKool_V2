```cshtml
@model KeelteKoolV2.Models.Lecturers.LecturerViewModel

@{
    ViewData["Title"] = "Delete lecturer";
}

<h1>Delete lecturer</h1>

<h3>Are you sure you want to delete this lecturer?</h3>

<div>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">First name</dt>
        <dd class="col-sm-10">@Model.FirstName</dd>

        <dt class="col-sm-2">Last name</dt>
        <dd class="col-sm-10">@Model.LastName</dd>

        <dt class="col-sm-2">Qualifications</dt>
        <dd class="col-sm-10">@Model.Qualifications</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
```