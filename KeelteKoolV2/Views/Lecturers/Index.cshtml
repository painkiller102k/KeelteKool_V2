```cshtml
@model IEnumerable<KeelteKoolV2.Models.Lecturers.LecturerViewModel>

@{
    ViewData["Title"] = "Lecturers";
}

<h1>Lecturers</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add lecturer</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>First name</th>
            <th>Last name</th>
            <th>Qualifications</th>
            <th>Created at</th>
            <th>Modified at</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var lecturer in Model)
        {
            <tr>
                <td>@lecturer.FirstName</td>
                <td>@lecturer.LastName</td>
                <td>@lecturer.Qualifications</td>
                <td>@lecturer.CreatedAt?.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@lecturer.ModifiedAt?.ToString("dd.MM.yyyy HH:mm")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@lecturer.Id">Details</a> |
                    <a asp-action="Update" asp-route-id="@lecturer.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@lecturer.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
```